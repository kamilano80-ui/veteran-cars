{* Latte template *}

{block content}

{*
    <h1 class="my-4">{$categoryName}</h1>
*}

    <!-- Blog Post -->
    <div n:foreach="$articles as $article" class="card mb-4">
        
    <div class="card-body d-flex">
        <img src="{$basePath}/images/articles/{$article->id}.png" 
         alt="{$article->title}" 
         class="me-3"
         style="margin-right: 30px; width: 120px; height: 80px; object-fit: cover;">

        <div>
        <h2 class="card-title">{$article->title}</h2>
        <p class="card-text">{$article->short_description}</p>
        <a n:href="Article:detail $article->id" class="btn btn-danger">
            Celý článek &rarr;
        </a>
        </div>
    </div>
        
      
    </div>
