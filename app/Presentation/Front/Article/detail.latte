{* Latte template *}

{block content}

{*
    <h1 class="my-4">{$article->title}</h1>
*}

    <!-- Blog Post -->
    <div class="card mb-4">
        {if $article->has_picture}
        <img class="card-img-top mt-4" src="{$basePath}/images/articles/{$article->id}.png?{time()}" alt="{$article->title}" style="width: 50%;">
        {/if}
        <div class="card-body">
            <h2 class="card-title">{$article->title}</h2>
            <p class="card-text">{$article->description|noescape}</p>
        </div>
        <div class="card-footer text-muted">
            Publikováno: {$article->date_add|date:'j. n. Y H:i'}
        </div>
            {control comments}
    </div>
